# For Railway deployment, set these variables in the Railway dashboard.
# DATABASE_URL is auto-generated by Railway's MySQL plugin.

# Database connection (auto-provided by Railway MySQL plugin)
DATABASE_URL=mysql+pymysql://username:password@host:3306/senior_project

# Application name (optional)
APP_NAME=AI Attendance Backend

# CORS allowed origins (use * for development, or specific URLs in production)
ALLOWED_ORIGINS=*
