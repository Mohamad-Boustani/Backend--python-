{
  "$schema": "https://schema.railpack.com",
  "deploy": {
    "runtime": "python-3.11",
    "aptPackages": [
      "libx11-6",
      "libglib2.0-0",
      "libsm6",
      "libxext6",
      "libxrender1",
      "libpng16-16",
      "libjpeg62-turbo",
      "libwebp7",
      "libtiff6",
      "libopenjp2-7",
      "zlib1g"
    ],
    "startCommand": "uvicorn app.main:app --host 0.0.0.0 --port $PORT"
  }
}